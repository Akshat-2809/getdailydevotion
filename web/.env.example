# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Canonical site URL, used for metadata, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://getdailydevotion.com

# Postgres connection string. On Vercel, adding Neon from the Marketplace
# (Storage → Create Database → Neon) sets this automatically. Use the pooled URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dailydevotion

# Random secret used to hash visitor IPs for rate limiting (`openssl rand -hex 32`).
IP_HASH_SALT=

# Protects GET /api/waitlist/stats (send it as the X-Admin-Token header).
ADMIN_TOKEN=

# Resend (https://resend.com). EMAIL_FROM must use a domain verified in Resend.
# Without RESEND_API_KEY the forms still work and emails are skipped with a log line.
RESEND_API_KEY=
EMAIL_FROM="Daily Devotion <support@getdailydevotion.com>"
# Inbox that gets a note for each sign-up and each contact message.
NOTIFY_EMAIL=
